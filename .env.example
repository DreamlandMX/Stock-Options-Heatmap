# 后端 HTTP 端口。
PORT=8787

# 数据源选择：demo、auto 或 moomoo。公开仓库和默认运行建议使用 demo。
OPTIONS_PROVIDER=demo

# Moomoo/Futu OpenD。使用实时数据源前，请先在本机启动 OpenD。
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# 已安装 moomoo-api 的 Python 可执行文件。留空时默认使用 "python"。
MOOMOO_PYTHON=python

# 若为 true，auto 模式会先尝试 OpenD，失败后回退到 demo。
# 公开 GitHub 默认值建议保持 false。
MOOMOO_AUTO_CONNECT=false
