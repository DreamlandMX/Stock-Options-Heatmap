# Backend HTTP port.
PORT=8787

# Provider selection: demo, auto, or moomoo. Demo is safest for public/default use.
OPTIONS_PROVIDER=demo

# Moomoo/Futu OpenD. Start OpenD locally before using the live provider.
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Python executable with moomoo-api installed. Leave blank to use "python".
MOOMOO_PYTHON=python

# If true, auto mode tries OpenD first and falls back to demo on failure.
# Keep false for the public GitHub default.
MOOMOO_AUTO_CONNECT=false
